# ────────────────────────────────────────────────
# OpSauce — environment variables
# Copy to .env and fill in real values for production.
# ────────────────────────────────────────────────

# Database
# Dev default (SQLite, zero-config):
DATABASE_URL="file:./dev.db"
# Production example (PostgreSQL):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/opsauce?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="OpSauce"

# Auth — session cookie signing key. Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# ── AI (on-device via Ollama) ───────────────────────────────────
# Powers: Eligibility Analysis, Readiness Check, Recommendations, Application Assistant.
# Every call falls back to a rule-based heuristic if the model is unreachable.
AI_ENABLED="true"
OLLAMA_BASE_URL="http://localhost:11434"   # default Ollama endpoint
AI_MODEL="llama3.1"                        # any model you've `ollama pull`ed
AI_DISPLAY_NAME="NovaMind5.8"              # friendly name shown in the UI
# AI_API_KEY=""                            # only if your endpoint needs a bearer token

# Works with any OpenAI-compatible local server — point OLLAMA_BASE_URL at it:
#   LM Studio   -> http://localhost:1234
#   llama.cpp   -> http://localhost:8080
