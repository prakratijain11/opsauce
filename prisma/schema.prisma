// OpportunityOS AI — data model
// Dev: SQLite. Production: switch provider to "postgresql" and update DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       Profile?
  applications  Application[]
  documents     Document[]
  savedItems    SavedOpportunity[]
  notifications Notification[]
}

model Profile {
  id                 String  @id @default(cuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline           String?
  educationLevel     String?   // e.g. "Undergraduate - 2nd Year"
  fieldOfStudy       String?   // e.g. "Computer Science & Engineering"
  institution        String?
  graduationYear     Int?
  cgpa               Float?
  country            String?
  city               String?

  interests          String    @default("[]") // JSON array of strings
  careerGoals        String    @default("[]") // JSON array of strings
  preferredTypes     String    @default("[]") // JSON array of OpportunityType
  completeness       Int       @default(0)    // 0-100

  onboarded          Boolean   @default(false)
  preferences        String    @default("{}") // JSON object of discovery preferences
  notificationPrefs  String    @default("{}") // JSON object of notification toggles

  updatedAt          DateTime  @updatedAt
}

model Opportunity {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  organizer      String
  type           String   // OpportunityType enum-as-string
  shortSummary   String
  description    String
  location       String   @default("Online")
  mode           String   @default("Online") // Online | Offline | Hybrid
  status         String   @default("Open")   // Open | Upcoming | Closed
  logoText       String?  // short badge text e.g. "GATE"
  logoColor      String?  // tailwind-ish token or hex
  eligibility    String   @default("[]")     // JSON array of strings
  tags           String   @default("[]")     // JSON array of strings
  officialUrl    String?
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deadlines      Deadline[]
  applications   Application[]
  savedBy        SavedOpportunity[]
}

model Deadline {
  id            String   @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  label         String   // e.g. "Registration End"
  date          DateTime
  priority      String   @default("MEDIUM") // HIGH | MEDIUM | LOW
  isPrimary     Boolean  @default(false)
}

model Application {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  stage         String   @default("SAVED") // SAVED | PREPARING | READY | SUBMITTED | RESULT
  readinessScore Int     @default(0)       // 0-100
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, opportunityId])
}

model Document {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  category    String   // e.g. "Marksheet", "ID Proof", "Certificate"
  fileType    String   // pdf | jpg | png
  sizeKb      Int      @default(0)
  status      String   @default("PENDING") // VERIFIED | PENDING | NEEDS_REVIEW
  uploadedAt  DateTime @default(now())
}

model SavedOpportunity {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([userId, opportunityId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  body      String
  kind      String   @default("INFO") // DEADLINE | RECOMMENDATION | SYSTEM | INFO
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
